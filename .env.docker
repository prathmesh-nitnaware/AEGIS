# ===========================================================================
# AEGIS Docker Environment Template
# .env.docker
# ===========================================================================
# Copy this file and edit values as needed.
# This file is loaded by docker-compose.yml via `env_file: .env.docker`.
# It is safe to commit (no real credentials) — this is just the template.
#
# For production: replace DATABASE_URL with your real NeonDB connection string.
# ===========================================================================

# --- Database (NeonDB PostgreSQL / SQLite fallback) ---
# Option A: NeonDB cloud PostgreSQL (recommended for multi-node production)
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Option B: SQLite file fallback (works out of the box, data persists in aegis-db volume)
DATABASE_URL=sqlite+aiosqlite:////app/db/aegis_cluster.db

# --- Agent defaults (overridden per-service in docker-compose.yml) ---
AGENT_ID=agent-default
COMMAND_NODE_URL=http://command-node:8000
HEARTBEAT_INTERVAL=5.0
POLL_INTERVAL=2.0
