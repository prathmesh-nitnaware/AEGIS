# ===========================================================================
# AEGIS EDR Agent Configuration Environment Template
# /etc/aegis/agent.env  or  C:\ProgramData\AEGIS\agent.env
# ===========================================================================

# Unique Agent ID (defaults to hostname if omitted)
AGENT_ID=node-01-linux

# Central Command Node URL (FastAPI backend + WebSocket)
COMMAND_NODE_URL=http://10.0.0.1:8000

# Heartbeat interval in seconds
HEARTBEAT_INTERVAL=5.0

# Silence-as-Alarm detection threshold in seconds
SILENCE_THRESHOLD=15.0

# P2P ZeroMQ / UDP Wire Mesh Consensus Settings
P2P_ENABLED=true
P2P_BIND_PORT=9001
P2P_PEERS=10.0.0.2:9002,10.0.0.3:9003

# Telemetry Collector Directories
PE_WATCH_DIR=/home/user/Downloads
HDFS_LOG_PATH=/var/log/syslog
# SCAPY_INTERFACE=eth0

# Automated Threat Mitigation & Quarantine Vault
ENABLE_ACTIVE_RESPONSE=true
QUARANTINE_DIR=/var/lib/aegis/quarantine
LOG_DIR=/var/log/aegis
