[Unit]
Description=AEGIS Endpoint Detection and Response (EDR) Agent Daemon
Documentation=https://github.com/prathmesh-nitnaware/AEGIS
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/aegis-agent
EnvironmentFile=-/etc/aegis/agent.env
ExecStart=/opt/aegis-agent/.venv/bin/python -m agent.daemon_service start
ExecStop=/opt/aegis-agent/.venv/bin/python -m agent.daemon_service stop
Restart=always
RestartSec=5s
TimeoutStopSec=15s

# Security Hardening & Resource Protection
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
LimitNOFILE=65535

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis-agent

[Install]
WantedBy=multi-user.target
