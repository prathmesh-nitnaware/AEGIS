# =============================================================================
# AEGIS Platform — Local Environment Template
# Copy this file to .env and adjust values for your local setup.
# .env is gitignored and will never be committed to source control.
# =============================================================================

# Main Server IP address (used by Agents to stream telemetry to Main Server)
MAIN_SERVER_IP=127.0.0.1

# Central Command Node URL (FastAPI Backend + WebSocket)
COMMAND_NODE_URL=http://127.0.0.1:8000

# Vite Frontends URL
VITE_COMMAND_NODE_URL=http://127.0.0.1:8000

# Optional: NeonDB / PostgreSQL connection string (defaults to SQLite fallback if not set)
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
